{
    "AppSettings": {
        "ShipServerSqlDb": {
            "ConnectionString": "",
            "DbType": "MySql",
            "Schema": "ship"
        },
        "EmrDb": {
            "ConnectionString": "",
            "DbType": "MySql",
            "Schema": null
        },
        "AllowedHosts": "*",

        "Hmac": {
            "Enabled": true,
            "RequireJwtAlso": true,
            "SignatureHeader": "X-SHIP-Signature",
            "TimestampHeader": "X-SHIP-Date",
            "NonceHeader": "X-SHIP-Nonce",
            "AllowedClockSkewSeconds": 300,
            "HmacAlgo": "HMACSHA256",
            "BypassPaths": [ "/health", "/swagger", "/docs", "/scalar" ]
        },

        "Clients": []
    },
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Debug"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Ship.Ses.Transmitter.Worker": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter",
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log.txt",
                    "rollingInterval": "Day",
                    "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ],
        "Properties": {
            "service": "ses-transmitter-service",
            "environment": "Development",
            "version": "1.0.0",
            "commitHash": "4d5c7a1"
        }
    },
    "SourceDbSettings": {
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "shipses"
    },
    "SeSClient": {
        "TenantId": "lakeshore",
        "HeartbeatSeconds": 90,
        "MetricsFlushSeconds": 300,
        "UseShipAdminApi": true
    },
    "FhirRouting": {
        "Default": {
            "BaseUrl": "https://ship-integration-gateway.k9.isw.la/fhir",
            "TimeoutSeconds": 30,
            "CallbackUrlTemplate": "https://ship-integration-gateway.k9.isw.la/fhir/callback/"
        },
        "Apis": [
            {
                "Name": "PDS",
                "Resources": [ "Patient" ],
                "BaseUrl": "https://ship-patient-demographics-service.k9.isw.la/pds",
                "TimeoutSeconds": 30
            },
            {
                "Name": "SCR",
                "Resources": [ "Observation", "AllergyIntolerance", "Condition" ],
                "BaseUrl": "https://ship-scr-service.k8.isw.la/api/v1/Encounter",
                "TimeoutSeconds": 45
            }
        ]
    },
    "AuthSettings": {
        "TokenEndpoint": "https://ship-identity-service.k9.isw.la/identity/api/v1/auth/token",
        "ClientId": "lakeshore",
        "ClientSecret": "",
        "GrantType": "client_credentials",
        "Scope": "ship-full-access"
    },
    "ShipAdminApi": {
        "BaseUrl": "https://ship-admin-api.k9.isw.la",
        "RequestTimeoutSeconds": 15,
        "BulkMetricsMaxItems": 500,
        "Retry": {
            "MaxAttempts": 3,
            "JitterMs": 250
        },
        "Heartbeat": {
            "IntervalSeconds": 30,
            "PathTemplate": "/api/v1/status/{clientId}/client/heartbeat"
        }
    },
    "ShipAdminAuth": {
        "TokenUrl": "https://ship-identity-service.k9.isw.la/api/v1/auth/token",
        "TenantId": "lakeshore",
        "ClientSecret": "",
        "GrantType": "client_credentials",
        "Scope": "ship-full-access"
    },
    "StatusProbe": {
        "Enabled": true,
        "TimeoutSeconds": 120,
        "PollIntervalSeconds": 30,
        "MaxAttempts": 3,
        "BatchSize": 50
    },
    "EmrCallback": {
        "TimeoutSeconds": 30,
        "MaxAttempts": 8,
        "Validation": {
            "Enabled": false,
            "RequireHttps": false,
            "AllowedHosts": [],
            "PerClient": {}
        },
        "Proxy": {
            "Enabled": true,
            "HostEnvironments": [ "Development", "Staging" ],
            "Address": "http://proxy.company.local:8080",
            "BypassOnLocal": true,
            "BypassList": [ "localhost", "127.0.0.1", "*.internal.local" ],
            "Auth": {
                "Type": "Basic",
                "Username": "__from_secret_store__",
                "Password": "__from_secret_store__"
            }
        }
    }

}